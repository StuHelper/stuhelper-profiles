  "components": {
    "schemas": {
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nickname",
          "nickname_required",
          "bio",
          "visibility",
          "revision",
          "group_card_consent"
        ],
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 20,
            "description": "Unicode code points; empty only while nickname_required is true."
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname_required": {
            "type": "boolean"
          },
          "bio": {
            "type": "string",
            "maxLength": 120
          },
          "visibility": {
            "$ref": "#/components/schemas/ProfileVisibility"
          },
          "group_card_consent": {
            "$ref": "#/components/schemas/GroupCardConsent"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "ProfileVisibility": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "school",
          "badge",
          "department",
          "grade",
          "reviews",
          "resources"
        ],
        "properties": {
          "school": {
            "type": "boolean",
            "default": true
          },
          "badge": {
            "type": "boolean",
            "default": true
          },
          "department": {
            "type": "boolean",
            "default": true
          },
          "grade": {
            "type": "boolean",
            "default": false
          },
          "reviews": {
            "type": "boolean",
            "default": true
          },
          "resources": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nickname",
          "revision"
        ],
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "Unicode code points, no leading/trailing whitespace or control/private-use characters."
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "bio": {
            "type": "string",
            "maxLength": 120
          },
          "visibility": {
            "$ref": "#/components/schemas/ProfileVisibility"
          },
          "group_card_consent": {
            "$ref": "#/components/schemas/GroupCardConsent"
          }
        }
      },
      "PublicProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nickname",
          "bio",
          "visibility",
          "affiliations",
          "facts_state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string",
            "maxLength": 20,
            "description": "Unicode code points; empty only while nickname_required is true."
          },
          "bio": {
            "type": "string",
            "maxLength": 120
          },
          "visibility": {
            "$ref": "#/components/schemas/ProfileVisibility"
          },
          "affiliations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/PublicAffiliation"
            }
          },
          "facts_state": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "hidden"
            ],
            "description": "Current academic facts; unavailable never prevents reading the basic profile."
          }
        }
      },
      "PublicAffiliation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school_id": {
            "type": "string",
            "maxLength": 200
          },
          "school_name": {
            "type": "string",
            "maxLength": 200
          },
          "department": {
            "type": "string",
            "maxLength": 200
          },
          "grade": {
            "type": "string",
            "maxLength": 200
          },
          "badge": {
            "type": "string",
            "maxLength": 200,
            "enum": [
              "student",
              "teacher"
            ]
          }
        }
      },
      "Closure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "revision",
          "requested_at",
          "cooling_ends_at",
          "completed_steps",
          "blocker",
          "points_policy",
          "profile_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "cooling",
              "cancelled",
              "awaiting_assets",
              "processing",
              "closed"
            ]
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "requested_at": {
            "type": "string",
            "format": "date-time"
          },
          "cooling_ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_steps": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "assets",
                "sessions",
                "authorizations",
                "content"
              ]
            }
          },
          "blocker": {
            "type": "string",
            "enum": [
              "",
              "assets_unavailable",
              "assets_pending",
              "sessions_unavailable",
              "authorizations_unavailable",
              "content_unavailable"
            ]
          },
          "points_policy": {
            "type": "string",
            "enum": [
              "forfeit_all_points_and_pending_deductions"
            ]
          },
          "profile_id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable application profile identifier. Shared SSO identifiers are not exposed."
          },
          "skipped_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "billing",
                "open-platform",
                "reviews",
                "resources",
                "favorites",
                "qq-binding"
              ]
            },
            "uniqueItems": true,
            "description": "经持久安装记录确认从未安装并跳过的模块。缺失或未知记录不能跳过。"
          }
        }
      },
      "ClosureRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "acknowledge_points_forfeiture"
        ],
        "properties": {
          "acknowledge_points_forfeiture": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "The applicant acknowledges that all points and pending deductions are cleared only during final processing, without cash or Ivory conversion."
          }
        }
      },
      "ClosurePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Closure"
            }
          }
        }
      },
      "GroupCardConsent": {
        "type": "object",
        "additionalProperties": false,
        "description": "群名片用途逐字段许可，默认全部拒绝；所有字段必须提供。",
        "required": [
          "school",
          "grade",
          "department",
          "name",
          "student_id",
          "gender",
          "nickname"
        ],
        "properties": {
          "school": {
            "type": "boolean"
          },
          "grade": {
            "type": "boolean"
          },
          "department": {
            "type": "boolean"
          },
          "name": {
            "type": "boolean"
          },
          "student_id": {
            "type": "boolean"
          },
          "gender": {
            "type": "boolean"
          },
          "nickname": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "stuhelper_session"
      }
    }
  }
}
